# Project: OS-001
# Date: 2026-11-25
# Authors: kwan, oda, sokpheng001
#
# Editor settings shared by all contributors (https://editorconfig.org).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,S,ld}]
indent_style = tab
indent_size = 8

[Makefile]
indent_style = tab

[*.{sh,py,yml,yaml}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
